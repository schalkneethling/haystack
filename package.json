{
  "name": "haystack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "prepare": "vp config",
    "lint:styles": "stylelint \"**/*.{css,scss}\"",
    "lint:styles:fix": "stylelint \"**/*.{css,scss}\" --fix",
    "knip": "knip",
    "lint:html": "html-validate \"**/*.html\"",
    "env:load": "varlock load",
    "repo:controls:check": "node scripts/repository-controls.mjs",
    "repo:controls:apply": "node scripts/repository-controls.mjs --apply",
    "quality": "vp check && vp test --passWithNoTests && pnpm lint:styles && pnpm lint:html && pnpm knip && pnpm env:load"
  },
  "devDependencies": {
    "@schalkneethling/stylelint-plugin-css-property-type-validator": "0.1.0-beta.1",
    "html-validate": "^11.16.2",
    "knip": "^6.39.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-plugin-logical-css": "^2.1.0",
    "stylelint-plugin-use-baseline": "^1.4.6",
    "typescript": "~6.0.2",
    "varlock": "^1.21.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  }
}
