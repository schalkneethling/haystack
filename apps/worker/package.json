{
  "name": "@haystack/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./e2e/fixtures": "./e2e/fixtures.ts"
  },
  "scripts": {
    "dev": "varlock-wrangler dev",
    "deploy": "vp build && wrangler deploy",
    "types": "wrangler types --strict-vars=false",
    "types:check": "wrangler types --strict-vars=false --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:export:remote": "mkdir -p backups && stamp=$(date -u +%Y%m%dT%H%M%SZ) && wrangler d1 export DB --remote --no-data --skip-confirmation --output=backups/haystack-$stamp-schema.sql && wrangler d1 export DB --remote --no-schema --skip-confirmation --output=backups/haystack-$stamp-data.sql",
    "fixtures": "node test/fixture-server.ts",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install --only-shell chromium",
    "test:voiceover": "playwright test --config playwright.voiceover.config.ts",
    "voiceover:setup": "guidepup setup",
    "voiceover:install": "guidepup install voiceover && playwright install webkit"
  },
  "dependencies": {
    "@haystack/schemas": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "entities": "^8.1.0",
    "oauth4webapi": "^3.8.8",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@guidepup/guidepup": "^0.36.4",
    "@guidepup/playwright": "^0.20.0",
    "@guidepup/setup": "^0.29.3",
    "@playwright/test": "catalog:",
    "@types/node": "^25.9.9",
    "@valibot/to-json-schema": "^1.8.0",
    "@varlock/1password-plugin": "^2.0.5",
    "@varlock/cloudflare-integration": "^1.6.2",
    "drizzle-kit": "^0.31.11",
    "html-validate": "^11.17.0",
    "msw": "^3.0.3",
    "varlock": "^1.23.0",
    "vite": "catalog:",
    "wrangler": "4.151.3"
  }
}
