{
  "name": "@haystack/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "varlock-wrangler dev",
    "types": "wrangler types --strict-vars=false",
    "types:check": "wrangler types --strict-vars=false --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install --only-shell chromium",
    "test:voiceover": "playwright test --config playwright.voiceover.config.ts",
    "voiceover:setup": "guidepup setup",
    "voiceover:install": "guidepup install voiceover && playwright install webkit"
  },
  "dependencies": {
    "@haystack/schemas": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "oauth4webapi": "^3.8.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.63.0",
    "@guidepup/guidepup": "^0.35.0",
    "@guidepup/playwright": "^0.19.1",
    "@guidepup/setup": "^0.29.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "@varlock/1password-plugin": "^2.0.5",
    "@varlock/cloudflare-integration": "^1.6.1",
    "drizzle-kit": "^0.31.11",
    "html-validate": "^11.16.2",
    "varlock": "^1.22.0",
    "vite": "catalog:",
    "wrangler": "4.148.0"
  }
}
