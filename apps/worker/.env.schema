# Worker environment for local development only. varlock-wrangler dev resolves this file
# from apps/worker. Shared items come from the root schema. Deployed Workers read secrets
# set in Cloudflare, and CI needs none. Items here are sensitive unless marked @public.
# @import(../../)
# @defaultSensitive=true
# @defaultRequired=infer
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true, account=my.1password.com)
# ---

# Google OAuth client secret, for sign-in (Phase 2). Also listed in wrangler.jsonc
# `secrets.required`.
# @sensitive @required
GOOGLE_CLIENT_SECRET=op("op://dev/Haystack Google OAuth/GOOGLE_OAUTH_CLIENT_SECRET")
