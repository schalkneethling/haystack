# Worker environment for local development only. varlock-wrangler dev resolves this file
# from apps/worker. Shared items come from the root schema. Deployed Workers read secrets
# set in Cloudflare, and CI needs none. Items here are sensitive unless marked @public.
# @import(../../)
# @defaultSensitive=true
# @defaultRequired=infer
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true, account=my.1password.com)
# ---

# Google OAuth client secret, for sign-in (Phase 2). Also listed in wrangler.jsonc
# `secrets.required`.
# @sensitive @required
GOOGLE_CLIENT_SECRET=op("op://dev/Haystack Google OAuth/GOOGLE_OAUTH_CLIENT_SECRET")

# TypeSafe API key, for the Jev questions in enrichment (#122). Also listed in wrangler.jsonc
# `secrets.required`. The 1Password item is referenced by its ID, so renaming it doesn't break this.
# @sensitive @required
TYPESAFE_API_KEY=op("op://dev/be344swl54q6yloegahiahdrse/TYPESAFE_AI_JEV")

# GitHub fine-grained personal access token that reads public repositories only, for the
# repository and README of a GitHub bookmark (#123). Also listed in wrangler.jsonc
# `secrets.required`. It is in the same 1Password item as TYPESAFE_API_KEY.
# @sensitive @required
GITHUB_TOKEN=op("op://dev/be344swl54q6yloegahiahdrse/GITHUB_PAT")

# Claude API key, for a bookmark's prose enrichment (#124). It must be scoped to a single
# workspace, because the adapter sends no `anthropic-workspace-id` header. Also listed in
# wrangler.jsonc `secrets.required`. It is in the same 1Password item as TYPESAFE_API_KEY.
# @sensitive @required
ANTHROPIC_API_KEY=op("op://dev/be344swl54q6yloegahiahdrse/ANTHROPIC_API_KEY")
