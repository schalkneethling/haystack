# Worker environment. varlock-wrangler resolves this file from apps/worker. Shared items
# come from the root schema. Items here are sensitive unless marked @public, so a new
# secret cannot be deployed as a plain var by accident.
# @import(../../)
# @currentEnv=$APP_ENV
# @defaultSensitive=true
# @defaultRequired=infer
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=forEnv(development), account=my.1password.com)
# ---

# 1Password service account token. Empty in local development, where the desktop app
# authenticates instead. Deploys must set it (see #16).
# @type=opServiceAccountToken @sensitive @internal @required=forEnv(staging, production)
OP_TOKEN=

# Google OAuth client secret, for sign-in (Phase 2). Also listed in wrangler.jsonc
# `secrets.required`.
# @sensitive @required
GOOGLE_CLIENT_SECRET=op("op://dev/Haystack Google OAuth/GOOGLE_OAUTH_CLIENT_SECRET")
