{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "haystack",
  "main": "src/index.ts",
  // The newest date the installed workerd (1.20261001.1) supports.
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "haystack",
      "database_id": "e899dd90-3f7f-424f-bd6f-f4f93577eb1e",
      // Written by drizzle-kit generate, applied only by wrangler d1 migrations apply.
      "migrations_dir": "migrations",
    },
  ],
  // Static assets (CSS, JS, images; never HTML). `wrangler dev` and the test harness read this
  // directory; `vp build` copies Vite's `publicDir` instead and ignores this field, so the two
  // must name the same directory (vite.config.ts). A request for an existing file is served
  // without running the Worker; every other request goes to the Worker (#43).
  "assets": { "directory": "../web/public" },
  // The Google OAuth client's local redirect URI is http://localhost:5173/auth/callback.
  "dev": { "port": 5173 },
  // Static configuration (plan, "Secrets and configuration"). Tests override these.
  "vars": {
    // Comma-separated. Checked at sign-in and on every request.
    "ALLOWED_EMAILS": "volume4.schalk@gmail.com",
    // Google OpenID Connect. The client ID is public (RFC 6749, section 2.2); the secret is in
    // `secrets`. Endpoints match https://accounts.google.com/.well-known/openid-configuration.
    "GOOGLE_CLIENT_ID": "1038205631826-jnqo837tfurq0hovmavo98bc62s4475k.apps.googleusercontent.com",
    "GOOGLE_ISSUER": "https://accounts.google.com",
    "GOOGLE_AUTHORIZATION_ENDPOINT": "https://accounts.google.com/o/oauth2/v2/auth",
    "GOOGLE_TOKEN_ENDPOINT": "https://oauth2.googleapis.com/token",
    "GOOGLE_JWKS_URI": "https://www.googleapis.com/oauth2/v3/certs",
    // TypeSafe's API, which serves Jev (https://docs.typesafe.ai/api/system-one.md). The key is
    // in `secrets`. The model is pinned, so answers stay comparable until an upgrade is chosen.
    "JEV_BASE_URL": "https://api.typesafe.ai",
    "JEV_MODEL": "jev-1.13.0",
    // GitHub's REST API, for the repository and README of a GitHub bookmark
    // (https://docs.github.com/en/rest/repos/repos#get-a-repository). The token is in `secrets`.
    "GITHUB_API_BASE_URL": "https://api.github.com",
    // The Claude API, for a bookmark's prose enrichment
    // (https://platform.claude.com/docs/en/api/messages). The key is in `secrets`. Schalk chose
    // the model (#118). It is pinned, so enrichments stay comparable until an upgrade is chosen.
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "ANTHROPIC_MODEL": "claude-haiku-5-5",
    // Cloudflare AI Gateway, which passes the same request on to Anthropic
    // (https://developers.cloudflare.com/ai-gateway/usage/providers/anthropic/), so it uses
    // ANTHROPIC_MODEL and ANTHROPIC_API_KEY. Its token is in `secrets`. The account ID isn't a
    // secret. The gateway is created with the name `haystack` (plan, "Deploys").
    "AI_GATEWAY_BASE_URL": "https://gateway.ai.cloudflare.com",
    "AI_GATEWAY_ACCOUNT_ID": "369e0fbadd08f6f15efd9fb63c7f5193",
    "AI_GATEWAY_ID": "haystack",
    // The provider enrichment uses, by its `id`: `anthropic` or `ai-gateway`. A `var`, not a
    // Flagship flag, so changing who receives bookmark data is a reviewed deploy (#125).
    "ENRICHMENT_PROVIDER": "ai-gateway",
    // A bookmark whose sensitivity noul is at or above this, from 0 to 1, is Held until the user
    // confirms that the link isn't private. Schalk chose 0.5 (#126). A `var`, not a Flagship
    // flag, so changing which bookmarks are Held is a reviewed deploy.
    "SENSITIVE_WARN_THRESHOLD": "0.5",
  },
  // Values come from .env.schema through varlock. A secret is added here in the change
  // whose code first reads it, even before production calls that code, as with
  // TYPESAFE_API_KEY (#122), GITHUB_TOKEN (#123), ANTHROPIC_API_KEY (#124) and
  // AI_GATEWAY_TOKEN (#125). GOOGLE_CLIENT_SECRET is the exception, see #8.
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_SECRET",
      "TYPESAFE_API_KEY",
      "GITHUB_TOKEN",
      "ANTHROPIC_API_KEY",
      "AI_GATEWAY_TOKEN",
    ],
  },
  // Runtime switches (plan decision 20). Only the configuration module reads this binding.
  "flagship": [{ "binding": "FLAGS", "app_id": "0166d45b-a0b5-41e5-9eef-53c0b9987d81" }],
}
